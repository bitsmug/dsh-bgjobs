{
  "name": "bgjobs",
  "version": "0.1.23",
  "description": "独立于 DSH 进程的后台任务（schtasks 托管）：bgjob_submit/bgjob_status 工具、网页「后台任务监控」实时面板、任务退出自动通知创建者 agent。关 DSH/关终端不影响任务运行。",
  "type": "module",
  "license": "MIT",
  "author": "bgjobs-dev",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bgjobs",
    "background-jobs",
    "schtasks"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
